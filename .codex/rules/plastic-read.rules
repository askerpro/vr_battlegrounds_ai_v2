# Чтение Plastic вне песочницы: внутри неё возможна ложная ошибка авторизации.
# Только доверенный проект; запись и синхронизация требуют отдельного поручения.
prefix_rule(
    pattern = ["cm", "status", "--nochanges"],
    decision = "allow",
    justification = "Проверить доступ к Plastic без изменения рабочего пространства",
    match = ["cm status --nochanges"],
    not_match = ["cm status", "cm ci -a", "cm update"],
)
prefix_rule(
    pattern = ["cm", "find", "changeset"],
    decision = "allow",
    justification = "Прочитать changeset для независимой проверки доступа к Plastic",
    match = ["cm find changeset"],
    not_match = ["cm ci -a", "cm update", "cm find revision"],
)
