###############################################################################
# Set default behavior to automatically normalize line endings.
* text=auto eol=crlf

# Shell-скрипты и git-хуки обязаны оставаться с LF.
# С CRLF shebang превращается в "#!/bin/bash\r", и хук молча падает
# с "bad interpreter" при свежем clone на Windows.
.githooks/** text eol=lf
*.sh text eol=lf
# Новый внешний контроллер и его переносимые шаблоны используют LF.
Tools/agents/editor-broker.py text eol=lf
# Unity YAML merge driver.
# PhaseB: Unity сама пишет сериализованный YAML с LF, поэтому рабочая копия тоже LF.
# Правила стоят до LFS-блоков: LFS/-text исключения ниже побеждают.
*.unity text merge=unityyamlmerge eol=lf
*.prefab text merge=unityyamlmerge eol=lf
# .asset бывают YAML и бинарными (LightingData, NavMesh, TerrainData).
# Принудительный text меняет байты бинарного заголовка при checkout;
# известные бинарные .asset явно помечены binary в конце файла.
*.asset text=auto merge=unityyamlmerge eol=lf
*.meta text eol=lf
*.controller text merge=unityyamlmerge eol=lf
*.anim text merge=unityyamlmerge eol=lf
# Прочие текстовые форматы Unity, реально присутствующие в индексе.
*.mat text eol=lf
*.overrideController text eol=lf
*.mask text eol=lf
*.physicMaterial text eol=lf
*.physicsMaterial2D text eol=lf
*.lighting text eol=lf
*.preset text eol=lf
*.giparams text eol=lf
*.terrainlayer text eol=lf
*.mixer text eol=lf
*.asmdef text eol=lf
*.asmref text eol=lf
*.inputactions text eol=lf
*.uss text eol=lf
*.uxml text eol=lf
# Source and docs - UTF-8
*.cs text eol=crlf
*.md text eol=crlf
# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.tga binary
*.fbx binary
*.dll binary
*.wav binary
*.mp3 binary
*.ogg binary
# Полные оружейные/солдатские паки используются в игре. Бинарники — LFS,
# код, .meta, YAML-префабы/сцены/материалы остаются обычным Git.
