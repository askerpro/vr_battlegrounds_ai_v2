#!/bin/bash
#
# post-commit — зеркалим состояние рабочей копии в Unity Version Control (Plastic SCM).
#
# Зачем: история проекта ведётся в git. Plastic нужен только для того, чтобы Unity
# показывала в инспекторе, какие значения полей изменились с прошлого чекина.
# Поэтому хук не переносит пофайловый дифф коммита — он фиксирует всё текущее
# состояние воркспейса одним чекином, чтобы Plastic не отставал от git.
#
# Почему не как раньше: прошлая версия делала
#     git diff-tree ... | cm ci -a -c "$MSG" -
# в расчёте, что `cm ci` прочитает пути из stdin. Такого режима у Plastic CLI нет:
# `cm checkin` принимает только список путей аргументами, и `-` уходил ему как
# ещё один путь. Плюс ошибки `cm add`/`cm rm` глушились в /dev/null, поэтому
# поломка была не видна.

set -o pipefail

COMMIT_MSG=$(git log -1 --format=%B)

# cm может отсутствовать в PATH, если git вызван не из обычной оболочки.
CM_BIN="cm"
if ! command -v "$CM_BIN" > /dev/null 2>&1; then
    CM_FALLBACK="/c/Program Files/PlasticSCM5/client/cm"
    if [ -x "$CM_FALLBACK" ]; then
        CM_BIN="$CM_FALLBACK"
    else
        echo "⚠️  Plastic CLI (cm) не найден — зеркалирование пропущено."
        echo "    Git-коммит при этом прошёл успешно."
        exit 0
    fi
fi

echo ""
echo "========================================="
echo "🔄 Зеркалим состояние в Unity Version Control (Plastic SCM)..."

# Один чекин на весь воркспейс:
#   -a             — учесть изменённые, перемещённые и удалённые локально
#   --applychanged — взять изменённые файлы без явного checkout
#   --private      — добавить новые файлы (фильтруются через ignore.conf)
# Так снимаются и лимит на длину командной строки, и возня с add/rm.
CM_OUTPUT=$("$CM_BIN" ci . -a --applychanged --private -c "$COMMIT_MSG" --noshowchangeset 2>&1)
CM_STATUS=$?

if [ $CM_STATUS -eq 0 ]; then
    echo "✅ Состояние перенесено в Plastic SCM."
elif echo "$CM_OUTPUT" | grep -qi "no changes\|nothing to check\|no items"; then
    echo "✅ Plastic уже синхронизирован — переносить нечего."
else
    # Ошибку показываем, а не прячем: молчаливый сбой здесь уже стоил месяцев расхождения.
    echo "⚠️  Не удалось перенести в Plastic (код $CM_STATUS). Git-коммит прошёл успешно."
    echo "$CM_OUTPUT" | head -20 | sed 's/^/    /'
fi

echo "========================================="
echo ""
exit 0
