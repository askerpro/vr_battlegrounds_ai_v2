#!/bin/bash
#
# post-commit — переносим файлы зафиксированного HEAD в Plastic SCM.
# Plastic нужен только подсветке изменений в инспекторе Unity, поэтому
# переносятся лишь Assets, Packages и ProjectSettings (см. ignore.conf).
# Рабочее содержимое этих файлов обязано совпадать с коммитом: частичный
# commit с оставшимися правками безопасно пропускается, без подмены файлов Unity.
# Проверки пакетные: по процессу git на шаг, а не на каждый файл.

set -o pipefail

ROOT=$(git rev-parse --show-toplevel) || exit 0
cd "$ROOT" || exit 0
COMMIT=$(git rev-parse HEAD) || exit 0
COMMIT_MSG=$(git log -1 --format=%B "$COMMIT") || exit 0

# NUL сохраняет пробелы/Unicode; --no-renames превращает rename в D+A,
# чтобы Plastic получил оба пути. Merge сравнивается с первым родителем.
MANIFEST=$(mktemp) || exit 0
trap 'rm -f "$MANIFEST"' EXIT
PARENT=$(git rev-parse --verify "$COMMIT^1" 2>/dev/null) || PARENT=""
if [ -n "$PARENT" ]; then
    git diff --name-only --no-renames -z "$PARENT" "$COMMIT" -- > "$MANIFEST" || exit 0
else
    git diff-tree --root --no-commit-id --name-only --no-renames -r -z "$COMMIT" > "$MANIFEST" || exit 0
fi

FILES=()
while IFS= read -r -d '' path; do
    case "$path" in
        Assets/*|Packages/*|ProjectSettings/*) ;;
        *) continue ;;
    esac
    # Plastic применяет checkin рекурсивно и понимает wildcards. Такие пути
    # нельзя отправлять как обычные файлы; gitlink/каталоги тоже запрещены.
    # Перевод строки запрещён ещё и потому, что пакетные проверки ниже построчные.
    if [[ "$path" == *$'\n'* || "$path" == *$'\r'* || "$path" == *'*'* || "$path" == *'?'* || -d "$path" ]]; then
        echo "⚠️  Plastic: небезопасный путь $path — перенос пропущен. Git-коммит успешен."
        exit 0
    fi
    FILES+=("$path")
done < "$MANIFEST"
[ ${#FILES[@]} -gt 0 ] || exit 0

# Рабочее дерево против коммита — одним вызовом по всему репозиторию.
declare -A DIRTY=()
while IFS= read -r -d '' path; do
    DIRTY["$path"]=1
done < <(git diff --name-only --no-renames -z "$COMMIT" --)

# Ожидаемые blob'ы коммита одним cat-file; удалённые пути дают "missing".
EXPECTED=()
mapfile -t EXPECTED < <(printf '%s\n' "${FILES[@]/#/$COMMIT:}" | git cat-file --batch-check='%(objectname)' | sed 's/ missing$//; s/^.*:.*$/missing/')
[ ${#EXPECTED[@]} -eq ${#FILES[@]} ] || { echo "⚠️  Plastic: сбой проверки blob'ов — перенос пропущен. Git-коммит успешен."; exit 0; }

# diff может доверять assume-unchanged/skip-worktree. Сверяем сам blob,
# применяя Git clean-фильтры (в том числе LFS и нормализацию CRLF):
# hash-object --stdin-paths фильтрует каждый файл по его атрибутам.
HASH_IDX=()
HASH_PATHS=()
PATHS=()
for i in "${!FILES[@]}"; do
    path=${FILES[$i]}
    if [ -n "${DIRTY[$path]}" ]; then
        echo "⚠️  Plastic: $path отличается от Git-коммита — перенос пропущен. Git-коммит успешен."
        exit 0
    fi
    if [ "${EXPECTED[$i]}" = "missing" ]; then
        # Git diff не видит private-файл, созданный снова после удаления в HEAD.
        if [ -e "$path" ] || [ -L "$path" ]; then
            echo "⚠️  Plastic: удалённый путь $path снова существует — перенос пропущен. Git-коммит успешен."
            exit 0
        fi
    elif [ -L "$path" ]; then
        ACTUAL=$(readlink -n "$path" | git hash-object --stdin) || exit 0
        if [ "$ACTUAL" != "${EXPECTED[$i]}" ]; then
            echo "⚠️  Plastic: содержимое $path отличается от Git-коммита — перенос пропущен. Git-коммит успешен."
            exit 0
        fi
    else
        HASH_IDX+=("$i")
        HASH_PATHS+=("$path")
    fi
    PATHS+=("./$path")
done
if [ ${#HASH_PATHS[@]} -gt 0 ]; then
    ACTUAL=()
    mapfile -t ACTUAL < <(printf '%s\n' "${HASH_PATHS[@]}" | git hash-object --stdin-paths) || exit 0
    [ ${#ACTUAL[@]} -eq ${#HASH_PATHS[@]} ] || { echo "⚠️  Plastic: сбой хеширования — перенос пропущен. Git-коммит успешен."; exit 0; }
    for k in "${!HASH_IDX[@]}"; do
        if [ "${ACTUAL[$k]}" != "${EXPECTED[${HASH_IDX[$k]}]}" ]; then
            echo "⚠️  Plastic: содержимое ${HASH_PATHS[$k]} отличается от Git-коммита — перенос пропущен. Git-коммит успешен."
            exit 0
        fi
    done
fi
[ ${#PATHS[@]} -gt 0 ] || exit 0

# cm может отсутствовать в PATH, если git вызван не из обычной оболочки.
CM_BIN="cm"
if ! command -v "$CM_BIN" > /dev/null 2>&1; then
    CM_FALLBACK="/c/Program Files/PlasticSCM5/client/cm"
    if [ -x "$CM_FALLBACK" ]; then
        CM_BIN="$CM_FALLBACK"
    else
        echo "⚠️  Plastic CLI (cm) не найден — зеркалирование пропущено."
        echo "    Git-коммит при этом прошёл успешно."
        exit 0
    fi
fi

echo ""
echo "========================================="
echo "🔄 Переносим Git-коммит ${COMMIT:0:12} в Plastic SCM (${#PATHS[@]} путей)..."

# Только явные файлы. Не разбивать на несколько check-in: один Git-коммит
# должен оставаться одной операцией. При лимите argv показываем ошибку.
# EOF запрещает интерактивное согласие на дополнительные зависимости Plastic.
CM_OUTPUT=$("$CM_BIN" ci "${PATHS[@]}" -a --applychanged --private --symlink -c "$COMMIT_MSG" --noshowchangeset </dev/null 2>&1)
CM_STATUS=$?

if [ $CM_STATUS -eq 0 ]; then
    echo "✅ Файлы Git-коммита перенесены в Plastic SCM."
elif echo "$CM_OUTPUT" | grep -qi "no changes\|nothing to check\|no items"; then
    echo "✅ По файлам Git-коммита в Plastic нет изменений."
else
    # Ошибку показываем, а не прячем: молчаливый сбой здесь уже стоил месяцев расхождения.
    echo "⚠️  Не удалось перенести в Plastic (код $CM_STATUS). Git-коммит прошёл успешно."
    echo "$CM_OUTPUT" | head -20 | sed 's/^/    /'
fi

echo "========================================="
echo ""
exit 0
