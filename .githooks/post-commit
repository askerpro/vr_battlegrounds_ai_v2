#!/bin/bash

# Получаем точный текст последнего коммита
COMMIT_MSG=$(git log -1 --format=%B)

echo ""
echo "========================================="
echo "🔄 Дублируем коммит в Unity Version Control (Plastic SCM)..."

# Группируем операции для повышения производительности и обхода лимита на длину аргументов
# Добавляем новые файлы (фильтр A)
git diff-tree -z --no-commit-id --name-only --diff-filter=A -r HEAD | xargs -0 -r cm add > /dev/null 2>&1

# Удаляем удаленные файлы (фильтр D)
git diff-tree -z --no-commit-id --name-only --diff-filter=D -r HEAD | xargs -0 -r cm rm > /dev/null 2>&1

# Коммитим все измененные пути передавая их через stdin (-)
git diff-tree --no-commit-id --name-only -r HEAD | cm ci -a -c "$COMMIT_MSG" -

if [ $? -eq 0 ]; then
    echo "✅ Успешно скопировано в Plastic SCM!"
else
    echo "⚠️ Ошибка коммита или Plastic SCM уже синхронизирован."
fi
echo "========================================="
echo ""
