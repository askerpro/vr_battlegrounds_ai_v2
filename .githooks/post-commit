#!/bin/bash

# Получаем точный текст последнего коммита, который вы только что сделали в Git
COMMIT_MSG=$(git log -1 --format=%B)

echo ""
echo "========================================="
echo "🔄 Дублируем коммит в Unity Version Control (Plastic SCM)..."

# Регистрируем в Plastic все новые/неотслеживаемые файлы 
cm add -R . > /dev/null 2>&1

# Делаем коммит всех измененных, добавленных и удаленных файлов с тем же сообщением
cm ci -a -c "$COMMIT_MSG"

if [ $? -eq 0 ]; then
    echo "✅ Успешно скопировано в Plastic SCM!"
else
    echo "⚠️ Изменения для Plastic SCM не найдены или произошла ошибка."
fi
echo "========================================="
echo ""
