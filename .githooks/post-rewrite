#!/bin/sh
# post-rewrite: git вызывает после rebase и commit --amend; $1 = rebase|amend,
# stdin — строки "<old-sha> <new-sha> [extra]" переписанных коммитов.
# rebase запускает post-checkout только в начале (переход на базу); файлы, которые
# пишутся при повторном применении коммитов ветки, проходят через smudge --skip
# основного checkout и остаются LFS-указателями. Здесь повторяем ту же гидратацию,
# что и post-checkout: configure_lfs_worktree.py checkout (git lfs checkout из
# локального кеша, без сети). Агентские worktree (hydration skip) не трогаем.
# amend рабочую копию не переписывает — ничего не делаем.
cat >/dev/null
[ "$1" = "rebase" ] || exit 0
[ -f Tools/agents/configure_lfs_worktree.py ] || exit 0
command -v git-lfs >/dev/null 2>&1 || { printf >&2 "\n%s\n\n" "This repository is configured for Git LFS but 'git-lfs' was not found on your path. If you no longer wish to use Git LFS, remove this hook by deleting the 'post-rewrite' file in the hooks directory (set by 'core.hookspath'; usually '.git/hooks')."; exit 2; }
# status только читает роль (main/worker/agent) и ничего не настраивает.
status=$(python Tools/agents/configure_lfs_worktree.py status) || exit $?
case "$status" in
    *'"role": "main"'*|*'"role": "worker"'*) ;;
    *) exit 0 ;;
esac
python Tools/agents/configure_lfs_worktree.py checkout || {
    code=$?
    printf >&2 "%s\n" "post-rewrite: LFS-гидратация после rebase не завершена; до открытия Unity выполнить python Tools/agents/configure_lfs_worktree.py checkout (при нехватке кеша — адресный git lfs pull)."
    exit $code
}
