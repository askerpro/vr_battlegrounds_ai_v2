#!/bin/sh
# post-rewrite: git вызывает после rebase и commit --amend; $1 = rebase|amend,
# stdin — строки "<old-sha> <new-sha> [extra]" переписанных коммитов.
# rebase запускает post-checkout только в начале (переход на базу); файлы, которые
# пишутся при повторном применении коммитов ветки, проходят через smudge --skip
# основного checkout и остаются LFS-указателями. Здесь та же гидратация, что
# у post-checkout (git lfs checkout из локального кеша, без сети), через общий
# configure_lfs_worktree.py hydrate: только main/worker, агентские worktree — no-op.
# amend рабочую копию не переписывает — ничего не делаем. Исход rebase хук не меняет:
# ошибки только сообщаются. При rebase --autostash git вызывает хук до применения
# autostash; грязный LFS-файл main восстановить: git lfs checkout -- <путь>.
cat >/dev/null
[ "$1" = "rebase" ] || exit 0
[ -f Tools/agents/configure_lfs_worktree.py ] || exit 0
command -v git-lfs >/dev/null 2>&1 || { printf >&2 "\n%s\n\n" "This repository is configured for Git LFS but 'git-lfs' was not found on your path. If you no longer wish to use Git LFS, remove this hook by deleting the 'post-rewrite' file in the hooks directory (set by 'core.hookspath'; usually '.git/hooks')."; exit 0; }
python Tools/agents/configure_lfs_worktree.py hydrate || printf >&2 "%s\n" "post-rewrite: LFS-гидратация после rebase не завершена; до открытия Unity выполнить python Tools/agents/configure_lfs_worktree.py checkout (при нехватке кеша — адресный git lfs pull)."
exit 0
