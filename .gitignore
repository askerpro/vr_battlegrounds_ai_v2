# This .gitignore file should be placed at the root of your Unity project directory
#
# Get latest from https://github.com/github/gitignore/blob/main/Unity.gitignore
#
.utmp/
.plastic/
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
*.log

# By default unity supports Blender asset imports, *.blend1 blender files do not need to be commited to version control.
*.blend1
*.blend1.meta

# MemoryCaptures can get excessive in size.
# They also could contain extremely sensitive data
/[Mm]emoryCaptures/

# Recordings can get excessive in size
/[Rr]ecordings/

# Uncomment this line if you wish to ignore the asset store tools plugin
# /[Aa]ssets/AssetStoreTools*

# Autogenerated Jetbrains Rider plugin
/[Aa]ssets/Plugins/Editor/JetBrains*
# Jetbrains Rider personal-layer settings
*.DotSettings.user

# Visual Studio cache directory
.vs/

# VS Code: коммитим только общекомандные конфиги, остальное — мусор расширений
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# Gradle cache directory
.gradle/

# Autogenerated VS/MD/Consulo solution and project files
ExportedObj/
.consulo/
*.csproj
!/Tools/TestStand/*.csproj
/Tools/TestStand/obj/
/Tools/TestStand/bin/
/UserSettings/VrBattlegrounds/
*.unityproj
*.sln
*.slnx
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity3D generated meta files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity3D generated file on crash reports
sysinfo.txt

# Mono auto generated files
mono_crash.*

# Builds
*.apk
*.aab
*.unitypackage
*.unitypackage.meta
*.app

# Crashlytics generated file
crashlytics-build.properties

# TestRunner generated files
InitTestScene*.unity*

# Addressables default ignores, before user customizations
/ServerData
/[Aa]ssets/StreamingAssets/aa*
/[Aa]ssets/AddressableAssetsData/link.xml*
/[Aa]ssets/Addressables_Temp*
# By default, Addressables content builds will generate addressables_content_state.bin
# files in platform-specific subfolders, for example:
# /Assets/AddressableAssetsData/OSX/addressables_content_state.bin
/[Aa]ssets/AddressableAssetsData/*/*.bin*

# Visual Scripting auto-generated files
/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Flow/UnitOptions.db
/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Flow/UnitOptions.db.meta
/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Core/Property Providers
/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Core/Property Providers.meta

# Auto-generated scenes by play mode tests
/[Aa]ssets/[Ii]nit[Tt]est[Ss]cene*.unity*

# Ignore TextMesh Pro examples as they often auto-modify
/[Aa]ssets/ThirdParty/TextMesh Pro/Examples & Extras/
/[Aa]ssets/ThirdParty/TextMesh Pro/Examples & Extras.meta

# Демо и общие ассеты FImpossible (Legs Animator) — в проекте не используются, держатся локально
/[Aa]ssets/ThirdParty/FImpossible Creations/Plugins - Animating/Legs Animator/Demos - Legs Animator/
/[Aa]ssets/ThirdParty/FImpossible Creations/Plugins - Animating/Legs Animator/Demos - Legs Animator.meta
/[Aa]ssets/ThirdParty/FImpossible Creations/Plugins - Shared/FBasic Assets/
/[Aa]ssets/ThirdParty/FImpossible Creations/Plugins - Shared/FBasic Assets.meta
/[Aa]ssets/ThirdParty/FImpossible Creations/Plugins - Shared/Utils/
/[Aa]ssets/ThirdParty/FImpossible Creations/Plugins - Shared/Utils.meta

# Embedded MCP package — local patched fork (execute_code fix)
/Packages/com.coplaydev.unity-mcp/

# Плеер и артефакты e2e-прогонов (ярус C, Tools/e2e/Run-E2E.ps1)
/Build/
/Tools/e2e/results/

# Временные файлы агентов и стендов (снимки LegsComparisonRig и т.п.)
/tmp/

# Постоянное локальное состояние агентов; не временные отчёты и не исходники.
/.agent-state/

# Локальный стабильный мост контроллера, установленный только в worktree редактора.
/Assets/Editor/VR_Battlegrounds/Debug/EditorBrokerLocal/
/Assets/Editor/VR_Battlegrounds/Debug/EditorBrokerLocal.meta

# Генерируемые локальные отчёты агентов; правило в AGENTS.md.
/tasks/*/reports/
# Старый каталог: уже созданные локальные отчёты также не попадают в историю.
/Docs/tasks/report/

# Локальные выгрузки диагностики хвата; не импортировать и не коммитить.
/UserReports/HandPoseFit/

# Чекпоинты конвейера аватара MEF (Blender) — большие бинарники, воспроизводятся скриптами Tools/mef-avatar
/Tools/mef-avatar/checkpoints/
/Tools/mef-avatar/out/

# Воспроизводимый байткод Python-инструментов
__pycache__/
*.py[cod]

# Измеритель позиций: отчёты/картинки/снимки входа уже исключены общим /Temp/ выше.
# Автоматические снимки Unity MCP для визуального ревью сцен.
/Assets/Screenshots/screenshot-*.png
/Assets/Screenshots/screenshot-*.png.meta
# Только результаты независимого .NET-харнесса; исходники и конфигурация сохраняются.
/Tools/LevelDesign/PositionImpactHarness/bin/
/Tools/LevelDesign/PositionImpactHarness/obj/
!/Tools/LevelDesign/PositionImpactHarness/PositionImpactHarness.csproj
