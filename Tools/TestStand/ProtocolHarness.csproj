<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <UseSharedCompilation>false</UseSharedCompilation>
    <DefineConstants Condition="Exists('../../Assets/Editor/VR_Battlegrounds/Testing/StandProtocol.cs')">$(DefineConstants);STAND_PROTOCOL_PRESENT</DefineConstants>
    <DefineConstants Condition="Exists('../../Assets/Scripts/Core/ClientDeviceIdentity.cs')">$(DefineConstants);PROFILE_SCOPES_PRESENT;UNITY_EDITOR</DefineConstants>
  </PropertyGroup>
  <ItemGroup><Compile Remove="obj/**;bin/**;EditorBindingStubs.cs" /></ItemGroup>
  <ItemGroup>
    <Compile Include="../../Assets/Scripts/Core/LocalClientProfile.cs" Link="Production/LocalClientProfile.cs" />
    <Compile Include="../../Assets/Scripts/Core/ClientDeviceType.cs" Link="Production/ClientDeviceType.cs" />
    <Compile Include="../../Assets/Scripts/Core/GameRole.cs" Link="Production/GameRole.cs" />
    <Compile Include="../../Assets/Scripts/Core/ClientDeviceIdentity.cs" Link="Production/ClientDeviceIdentity.cs" Condition="Exists('../../Assets/Scripts/Core/ClientDeviceIdentity.cs')" />
    <Compile Include="../../Assets/Scripts/Debug/E2E/E2EResult.cs" Link="Production/E2EResult.cs" />
  </ItemGroup>
  <ItemGroup Condition="Exists('../../Assets/Editor/VR_Battlegrounds/Testing/StandProtocol.cs')">
    <Compile Include="../../Assets/Editor/VR_Battlegrounds/Testing/StandProtocol.cs" Link="Production/StandProtocol.cs" />
  </ItemGroup>
</Project>
