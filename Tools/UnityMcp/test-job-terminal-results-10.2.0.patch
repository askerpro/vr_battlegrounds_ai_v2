+        // Terminal root содержит полное дерево NUnit; callback list теряется при domain reload.
+        private static IEnumerable<ITestResultAdaptor> TerminalLeaves(ITestResultAdaptor result)
+        {
+            if (result == null) yield break;
+            if (!result.HasChildren)
+            {
+                // Пустая suite не является testcase и не создаёт phantom result.
+                if (result.Test?.IsSuite != true) yield return result;
+                yield break;
+            }
+            foreach (var child in result.Children ?? Enumerable.Empty<ITestResultAdaptor>())
+                foreach (var leaf in TerminalLeaves(child)) yield return leaf;
+        }
+
